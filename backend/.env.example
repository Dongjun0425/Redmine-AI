# 이 파일을 .env 로 복사한 뒤 실제 값을 채워넣으세요. (.env는 git에 절대 커밋하지 마세요)

# Redmine (내 계정 > 접근하려면 https://issues.drbit.kr/redmine/my/account 에서 API 키 확인)
REDMINE_BASE_URL=https://issues.drbit.kr/redmine
REDMINE_API_KEY=여기에_본인_API_키_붙여넣기

# OpenAI (임베딩 + 검색어 키워드 확장용)
OPENAI_API_KEY=여기에_OpenAI_API_키_붙여넣기

# 로그인 세션 토큰 서명용 비밀키 (아무도 못 맞히는 긴 임의 문자열로. 터미널에서 생성하려면:
# python -c "import secrets; print(secrets.token_hex(32))")
SESSION_SECRET=여기에_긴_임의_문자열

# DB (2단계에서 클라우드 Postgres 준비되면 채움, 1단계에서는 필요 없음)
DATABASE_URL=
